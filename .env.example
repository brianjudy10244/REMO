# Create a Neon database through the Vercel Marketplace and paste its pooled URL.
DATABASE_URL="postgresql://..."

# Create a private Blob store and let Vercel add this value.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Use `node -e "console.log(require('bcryptjs').hashSync('choose-a-strong-password', 12))"`
ADMIN_USERNAME="remo_admin"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-a-real-bcrypt-hash"
AUTH_SECRET="replace-with-at-least-32-random-characters"
